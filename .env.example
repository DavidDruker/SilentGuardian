# Copy to .env and replace the local access secrets before sharing the app.
APP_ENV=development
DATABASE_URL=sqlite:///./data/guardian.db
OPERATOR_TOKEN=local-demo-only
SIGNING_SECRET=local-demo-signing-secret-change-before-deploy
PUBLIC_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
DEMO_ENABLED=false
NOTIFICATION_MODE=dry_run

# Optional Gemini review of ML-supported alerts. It can raise urgency, never lower it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Required in addition to each profile's explicit consent. Keep false until verified.
GEMINI_BILLED_PROJECT_CONFIRMED=false

# Optional web push
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:demo@example.com

# Optional ring-only demo call. Never infer the destination from a profile.
CALLS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEMO_CALL_TO=
CALL_TEST_ALLOWLIST=
CALL_COOLDOWN_SECONDS=300
CALL_DAILY_LIMIT=5

# Planning constraint; this is NOT a provider-enforced billing cap.
TIGER_BUDGET_LIMIT=1000
# Learned action classifier (the ML gate). Loaded in this process unless
# ML_SERVICE_URL points at a separate ML node. WITH_ACTION_MODEL=1 builds it into
# the compose.app.yaml image for a single-server deployment.
ACTION_MODEL_MODE=on
WITH_ACTION_MODEL=0
ACTION_MODEL_PATH=models/stgcnpp-ntu60-2d.pth
ACTION_MODEL_THREADS=2

# Private service endpoints on the Vultr VPC. Leave blank for one-process local use.
RULES_SERVICE_URL=
ML_SERVICE_URL=
INTERNAL_SERVICE_TOKEN=local-internal-demo-token
# Rules and ML nodes only: this node's VPC address, used by compose.rules.yaml / compose.ml.yaml.
PRIVATE_IP=
# enforce (default): rule hits are candidates and the ML decides which become alerts.
# If the model is unavailable, falls and stillness still alert as a safety fallback.
# shadow: rules alert directly; a supporting ML score only adds Gemini review.
DECISION_MODE=enforce
FALL_SCORE_THRESHOLD=0.4
MODEL_TIMEOUT_SECONDS=2

# Automatic personal-baseline update. Each completed local day contributes 20%
# by default; its processed pose windows are then deleted.
PERSONALIZATION_PREVIOUS_WEIGHT=0.8
PERSONALIZATION_TIMEZONE=America/Toronto
